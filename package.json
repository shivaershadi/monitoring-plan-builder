{
  "name": "monitoring-plan-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NRC Monitoring Plan Builder: monitoring-plan builder with no language model, static site on GitHub Pages (Product 3).",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src bank/scripts --ext .ts,.tsx",
    "bank:convert": "tsx bank/scripts/convert-v1-emergency-shelter.ts",
    "bank:validate": "tsx bank/scripts/validate-bank.ts",
    "bank:schema": "tsx bank/scripts/emit-json-schema.ts",
    "bank:countries": "tsx bank/scripts/build-countries.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "fake-indexeddb": "^6.2.6",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "competency": {
            "type": "string",
            "enum": [
              "ss",
              "wash",
              "icla",
              "edu",
              "pfv",
              "mpc"
            ]
          },
          "package_version": {
            "type": "string"
          }
        },
        "required": [
          "file",
          "competency",
          "package_version"
        ]
      }
    },
    "shared_modules_file": {
      "type": "string"
    },
    "countries_file": {
      "type": "string"
    },
    "changelog": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "version",
    "date",
    "packages"
  ]
}

          "enum": [
            "respondent",
            "enumerator"
          ]
        },
        "relevant": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "enum": [
                "=",
                "!=",
                "in",
                "not_in",
                "selected"
              ]
            },
            "values": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "ref",
            "op",
            "values"
          ]
        },
        "relevant_note": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "flag_values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "threshold_param": {
          "type": "string"
        },
        "source": {
